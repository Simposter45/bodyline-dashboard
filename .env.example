# ============================================================
# .env.example — Bodyline Dashboard
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.
#
# Vercel environment variable setup (3-Environment Pipeline):
#   Production  (main)    → your Production Supabase project keys
#   Preview     (develop) → your Dev Supabase project keys (UAT)
#   Development (local)   → your Dev Supabase project keys (Local)
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get these from: supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── WhatsApp / Meta Cloud API ────────────────────────────────
# [BLOCKED] — Awaiting Meta number re-registration
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# ── App ──────────────────────────────────────────────────────
# Used to differentiate behaviour between dev and prod
NEXT_PUBLIC_APP_ENV=development
# Values: "development" | "production"
